{
  "_comment": "화자 → edge-tts 음성 매핑, 음성 안의 쉼(초), 출력 형식. N·F2·M2는 voice_compare.py 비교로 확정 (N-1, F2-1, M2-1).",

  "voices": {
    "N":  { "voice": "ja-JP-NanamiNeural", "rate": "-5%",  "pitch": "+0Hz" },
    "F":  { "voice": "ja-JP-NanamiNeural", "rate": "+0%",  "pitch": "+0Hz" },
    "M":  { "voice": "ja-JP-KeitaNeural",  "rate": "+0%",  "pitch": "+0Hz" },
    "F2": { "voice": "ja-JP-NanamiNeural", "rate": "+0%",  "pitch": "+10Hz" },
    "M2": { "voice": "ja-JP-KeitaNeural",  "rate": "-5%",  "pitch": "-10Hz" }
  },

  "pauses": {
    "leadIn": 0.5,
    "situationToDialogue": 1.0,
    "betweenLines": 0.6,
    "dialogueToQuestion": 1.0,
    "questionToOptions": 1.0,
    "afterOptionNumber": 0.4,
    "betweenOptions": 1.0,
    "tail": 0.5
  },

  "optionNumbers": ["いち", "に", "さん", "よん"],

  "tts": { "retries": 3, "concurrency": 4 },

  "output": { "sampleRate": 24000, "bitrate": "64k", "loudnorm": "I=-16:TP=-1.5:LRA=11" },

  "compare": {
    "sentence": "すみません、来週の会議の資料は、もうできていますか。",
    "gap": 0.8,
    "reference": { "N": "F", "F2": "F", "M2": "M" },
    "candidates": {
