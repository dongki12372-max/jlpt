        { "label": "N-1 Nanami 느리게 (지시서 예시)", "voice": "ja-JP-NanamiNeural", "rate": "-5%",  "pitch": "+0Hz" },
        { "label": "N-2 Nanami 더 느리고 낮게",        "voice": "ja-JP-NanamiNeural", "rate": "-10%", "pitch": "-10Hz" },
        { "label": "N-3 Nanami 보통 속도, 많이 낮게",  "voice": "ja-JP-NanamiNeural", "rate": "+0%",  "pitch": "-20Hz" }
      ],
      "F2": [
        { "label": "F2-1 Nanami 조금 높게 (지시서 예시)", "voice": "ja-JP-NanamiNeural", "rate": "+0%", "pitch": "+10Hz" },
        { "label": "F2-2 Nanami 높고 빠르게 (젊은 여성)",  "voice": "ja-JP-NanamiNeural", "rate": "+5%", "pitch": "+20Hz" },
        { "label": "F2-3 Nanami 낮고 느리게 (나이 든 여성)", "voice": "ja-JP-NanamiNeural", "rate": "-5%", "pitch": "-15Hz" }
      ],
      "M2": [
        { "label": "M2-1 Keita 조금 낮고 느리게",         "voice": "ja-JP-KeitaNeural", "rate": "-5%",  "pitch": "-10Hz" },
        { "label": "M2-2 Keita 높고 빠르게 (젊은 남성)",   "voice": "ja-JP-KeitaNeural", "rate": "+5%",  "pitch": "+12Hz" },
        { "label": "M2-3 Keita 많이 낮고 느리게 (나이 든 남성)", "voice": "ja-JP-KeitaNeural", "rate": "-10%", "pitch": "-20Hz" }
      ]
    }
  }
}
