{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "문자·어휘 문제 은행 (data/vocab/questions/{n5,n4,n3}.json)",
  "description": "레벨별 파일에 문항 배열. 후리가나 {漢字|かんじ}, 밑줄 [[ ]], 빈칸 （　）. 세부 규칙은 tools/validate_vocab.py.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "level", "type", "stem", "stemFurigana", "options", "answer", "fullText", "fullFurigana", "fullKo", "targets", "explanation_ko", "optionNotes_ko", "tags"],
    "properties": {
      "id": { "type": "string", "pattern": "^n[345]-(yomi|hyouki|bunmyaku|iikae|youhou)-[0-9]{3}$" },
      "level": { "enum": ["N5", "N4", "N3"] },
      "type": { "enum": ["yomi", "hyouki", "bunmyaku", "iikae", "youhou"] },
      "stem": { "type": "string", "description": "문제 문장 (밑줄 [[ ]] 또는 빈칸 （　）). 用法은 빈 문자열" },
      "stemFurigana": { "type": "string", "description": "후리가나를 붙인 문제 문장. 漢字読み는 밑줄 부분에 후리가나 금지" },
      "word": { "type": "string", "minLength": 1, "description": "用法 전용 제시 단어" },
      "options": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "furigana": { "type": "string", "minLength": 1, "description": "表記·漢字読み 선택지에는 금지" }
          }
        }
      },
      "answer": { "type": "integer", "minimum": 1, "maximum": 4 },
      "fullText": { "type": "string", "minLength": 1, "description": "정답을 넣어 완성한 문장 (해설 표시·음성)" },
      "fullFurigana": { "type": "string", "minLength": 1 },
      "fullKo": { "type": "string", "minLength": 1, "description": "완성 문장의 한국어 해석" },
      "ttsText": { "type": "string", "minLength": 1, "description": "완성 문장 음성 읽기 교정 (fullFurigana 읽기와 같아야 함)" },
      "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^|]+\\|[^|]+$" } },
      "explanation_ko": { "type": "string", "minLength": 1 },
      "optionNotes_ko": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
