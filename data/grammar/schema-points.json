{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "문법 문형 (data/grammar/points/{n5,n4,n3}.json)",
  "description": "레벨별 파일에 한 줄에 문형 하나. 후리가나 {漢字|かんじ}. 세부 규칙은 tools/validate_grammar.py.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "key", "pattern", "level", "meaning_ko", "connection", "explanation_ko", "examples", "similar"],
    "properties": {
      "id": { "type": "string", "pattern": "^n[345]-g-[0-9]{3}$" },
      "key": { "type": "string", "minLength": 1, "description": "기록·참조 키. pattern과 같게 둔다 (id나 순서가 바뀌어도 기록 유지)" },
      "pattern": { "type": "string", "minLength": 1, "description": "문형 표기. 〜로 시작 (예: 〜てから, 〜なければならない). 조사·접속사 하나만이면 〜 없이 (예: でも, から)" },
      "level": { "enum": ["N5", "N4", "N3"] },
      "meaning_ko": { "type": "string", "minLength": 1, "description": "짧은 한국어 뜻 (예: ~하고 나서). 쉼표로 2개까지" },
      "connection": { "type": "string", "minLength": 1, "description": "접속 (예: 동사 て형 + から, 명사 + の + ために)" },
      "explanation_ko": { "type": "string", "minLength": 1, "description": "쓰임·뉘앙스·헷갈리기 쉬운 문형과의 차이, 2~3문장" },
      "examples": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["text", "furigana", "meaning_ko"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "furigana": { "type": "string", "minLength": 1 },
            "ttsText": { "type": "string", "minLength": 1, "description": "음성 읽기 교정 (furigana 읽기와 같아야 함)" },
            "meaning_ko": { "type": "string", "minLength": 1 }
          }
        }
      },
      "similar": { "type": "array", "items": { "type": "string" }, "description": "헷갈리기 쉬운 다른 문형의 key" },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
