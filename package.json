{
  "name": "jlpt-listening",
  "version": "0.4.0",
  "description": "JLPT 청해·문자어휘·문법 연습 — 웹 앱 (GitHub Pages). Electron은 자동 테스트에만 쓴다",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node tools/serve.js",
    "smoke": "npm run -s smoke:listening && npm run -s smoke:vocab && npm run -s smoke:grammar",
    "smoke:listening": "env -u ELECTRON_RUN_AS_NODE electron tools/smoke_app.js",
    "smoke:vocab": "env -u ELECTRON_RUN_AS_NODE electron tools/smoke_vocab.js",
    "smoke:grammar": "env -u ELECTRON_RUN_AS_NODE electron tools/smoke_grammar.js",
    "web:check": "env -u ELECTRON_RUN_AS_NODE electron tools/web_check.js",
    "web:deploy": "sh tools/deploy_web.sh"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  }
}
